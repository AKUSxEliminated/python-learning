# Supabase — paste the real values from your Supabase project's API settings.
# Leave empty until a project is configured; do not put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
AI_API_KEY=

# Override the Gemini default model if needed.
AI_MODEL=gemini-3.8-flash

# Optional OpenAI-compatible API base URL.
# Defaults to https://generativelanguage.googleapis.com/v1beta/openai.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
