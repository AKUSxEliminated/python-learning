# Supabase — paste the real values from your Supabase project's API settings.
# Leave empty until a project is configured; do not put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq API credentials. Keep these server-side; never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional model override. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=
